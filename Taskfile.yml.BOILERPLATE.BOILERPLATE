# https://taskfile.dev

version: '3'

dotenv:
  - .env
  - .env.dist

tasks:

  default:
    cmds:
      - task -l
    silent: true

  init:
    desc: Initialises the project
    sources:
      - mise.toml
    generates:
      - mise.lock
    cmds:
      - mise install

  build:
    desc: Builds the project
    deps:
      - init
    cmds:
      - echo "Implement me"
      - false

  run:
    desc: Runs the project
    deps:
      - build
    cmds:
      - echo "Implement me"
      - false

  test:
    desc: Test the project
    deps:
      - build
    cmds:
      - echo "Implement me"
      - false
