# https://taskfile.dev

version: '3'

dotenv:
  - .env
  - .env.dist

tasks:

  default:
    cmds:
      - task -l
    silent: true

  init_mise:
    desc: Initialises the project - mise
    sources:
      - mise.toml
    generates:
      - mise.lock
    cmds:
      - mise install

  init_precommit:
    desc: Initialises the project - pre-commit
    deps:
      - init_mise
    sources:
      - .pre-commit-config.yaml
    cmds:
      - pre-commit install

  init:
    desc: Initialises the project
    deps:
      - init_mise
      - init_precommit

  build:
    desc: Builds the project
    deps:
      - init
    cmds:
      - echo "Implement me"
      - false

  run:
    desc: Runs the project
    deps:
      - build
    cmds:
      - echo "Implement me"
      - false

  test:
    desc: Test the project
    deps:
      - build
    cmds:
      - echo "Implement me"
      - false
